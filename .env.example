# =========================
# Platform
# =========================
ENVIRONMENT=dev

# =========================
# Backend (Spring)
# =========================
NLP_SERVICE_URL=http://nlp-service:5000
LEGAL_STORAGE_DIR=./data
LEGAL_HISTORY_RETENTION_DAYS=30

# =========================
# AI Service (FastAPI)
# =========================
LEGAL_DATA_DIR=/data
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =========================
# Frontend (Vite)
# =========================
# Leave empty to use same-origin (recommended behind gateway)
VITE_API_URL=
